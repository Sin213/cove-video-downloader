{
  "name": "cove-video-downloader",
  "version": "3.1.3",
  "description": "Dark-themed GUI video downloader powered by yt-dlp, with optional H.265 compression via HandBrakeCLI.",
  "main": "main.js",
  "author": {
    "name": "Sin",
    "email": "79215527+Sin213@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Sin213/cove-video-downloader",
  "scripts": {
    "test": "npm run test:py && npm run test:js",
    "test:py": "python3 -m pytest tests/ -q",
    "test:js": "node --test \"tests/js/*.test.js\"",
    "vendor": "node scripts/vendor-assets.js",
    "prestart": "node scripts/vendor-assets.js",
    "start": "electron .",
    "predist": "node scripts/vendor-assets.js",
    "dist": "electron-builder",
    "predist:linux": "node scripts/vendor-assets.js",
    "dist:linux": "node scripts/fetch-runtimes.js linux && electron-builder --linux",
    "predist:win": "node scripts/vendor-assets.js",
    "dist:win": "node scripts/fetch-runtimes.js win && electron-builder --win",
    "prerelease": "node scripts/vendor-assets.js",
    "release": "node scripts/fetch-runtimes.js linux && node scripts/fetch-runtimes.js win && electron-builder --linux --win --publish=always"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "geist": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.sin.cove-video-downloader",
    "productName": "Cove Video Downloader",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "portable.js",
      "preload.js",
      "renderer/**/*",
      "python/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "python/**/*"
    ],
    "extraResources": [
      {
        "from": "runtimes/${os}",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Sin213",
        "repo": "cove-video-downloader"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "Cove-Video-Downloader-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "Cove-Video-Downloader-${version}-${arch}.deb",
      "depends": [
        "python3",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Cove-Video-Downloader-${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Cove Video Downloader",
      "artifactName": "Cove-Video-Downloader-${version}-Setup.exe"
    }
  }
}
